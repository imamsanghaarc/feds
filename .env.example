# Reference for the settings config.py reads.
#
# Copy this file to `.env` and fill in real values
# (PowerShell: `Copy-Item .env.example .env`). `.env` is gitignored and must
# never be committed. A deployed process should supply these as real environment
# variables instead, which always take precedence over `.env`.
#
# A provider with no key is treated as disabled, so set only the credentials for
# the providers you actually intend to use.

# --- Database ---------------------------------------------------------------
# Required. Owner credential: `setup_neon.py` uses it to create and migrate the
# schema. Run `uv run python setup_neon.py` after setting this.
NEON_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# --- Runtime database role (least privilege) --------------------------------
# Optional but recommended. `setup_neon.py` creates this login with rights only
# to the working tables (no ownership, DDL, role/database admin, or RLS bypass),
# and the worker and MCP server then connect with it instead of the owner, so a
# compromised app environment is no longer full database ownership. Leave unset
# to keep running on NEON_DATABASE_URL. See deployment.md.
# FEDS_APP_DB_ROLE=feds_app
# FEDS_APP_DB_PASSWORD=
# FEDS_APP_DATABASE_URL=postgresql://feds_app:password@host/neondb?sslmode=require

# --- Providers --------------------------------------------------------------
# Chat and embeddings are routed independently. Only providers with a real
# embeddings API can serve embeddings.

GEMINI_API_KEY=
GEMINI_ENABLED=1
# Optional second Gemini credential. It rotates in when GEMINI_API_KEY is out
# of quota and rotates back automatically when the primary's quota resets.
# Both credentials serve the same models, so stored vectors stay comparable.
GEMINI_FALLBACK_API_KEY=
GEMINI_FALLBACK_ENABLED=1
# gemini-2.5-flash is retired for newly provisioned keys (HTTP 404).
# Verified working: gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.6-flash,
# gemini-3.8-flash. gemini-flash-latest is often saturated (503).
GEMINI_CHAT_MODEL=gemini-3.5-flash

# Leave the key empty to keep OpenAI disabled.
OPENAI_API_KEY=
OPENAI_ENABLED=1
OPENAI_CHAT_MODEL=gpt-5-mini

# Any provider added as chat-only must NOT be added to EMBEDDING_MODELS in
# config.py; a test enforces that.

# Seconds a quota-exhausted provider waits before being retried.
PROVIDER_COOLDOWN_SECONDS=900

# --- Embeddings -------------------------------------------------------------
# Preferred embedding provider; the other is used automatically on quota failure.
EMBEDDING_PROVIDER=gemini

# --- MCP --------------------------------------------------------------------
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001

# Conversation id is injected by the worker; do not set it by hand.
# FRONTEND_CONVERSATION_ID=

# --- Safety -----------------------------------------------------------------
# Leave unset unless this host is allowed to publish to production.
# ALLOW_PRODUCTION_PUBLISH=1

# Who may approve or reject a parked run. Unset keeps single-operator local
# mode (only `operator-local` may decide). Set a comma-separated list to grant
# real names; the anonymous default is then refused unless it is listed too.
# FEDS_ALLOWED_OPERATORS=alice,bob